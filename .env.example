NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only Secret. Only xnd_development_ keys are accepted, never live keys.
XENDIT_SECRET_KEY=
# Explicit opt-in for customer sandbox on the production domain.
XENDIT_SANDBOX_ENABLED=false
# Server-only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Callback verification token from Xendit Test Mode webhook settings.
XENDIT_WEBHOOK_TOKEN=
